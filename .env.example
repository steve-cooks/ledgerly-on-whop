# ── Whop ────────────────────────────────────────────────────────────────────────────────
# Account API key for Ledgerly's platform account (server-side only). See README "API key scopes".
WHOP_API_KEY=apik_...
WHOP_PLATFORM_ACCOUNT_ID=biz_...
# Signing secret returned once when the webhook is created (scripts/part1/05a-create-webhook.ts writes it here).
WHOP_WEBHOOK_SECRET=ws_...
WHOP_WEBHOOK_ID=hook_...

# ── Database (Supabase transaction pooler, port 6543) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── App ─────────────────────────────────────────────────────────────────────────────────
# Public https URL (account links require https return/refresh URLs).
APP_URL=https://your-app.vercel.app
# Ledgerly's take rate in basis points (800 = 8%).
PLATFORM_FEE_BPS=800
# Bearer token Ledgerly's backend uses for /api/sellers, /api/checkouts, /api/reconcile (openssl rand -hex 32).
ADMIN_API_TOKEN=
# Signs the demo seller session cookie (openssl rand -base64 48).
SESSION_SECRET=
