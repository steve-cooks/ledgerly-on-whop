# ── Whop ────────────────────────────────────────────────────────────────────────────────
# Account API key for Ledgerly's platform account (server-side only). Scopes: README "API key scopes".
WHOP_API_KEY=apik_...
WHOP_PLATFORM_ACCOUNT_ID=biz_...
# Written by `pnpm ledgerly webhook:create` (the secret is shown only once).
WHOP_WEBHOOK_SECRET=ws_...
WHOP_WEBHOOK_ID=hook_...

# ── Database (Supabase transaction pooler, port 6543) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── App ─────────────────────────────────────────────────────────────────────────────────
# Public https URL (account links require https return/refresh URLs).
APP_URL=https://your-app.vercel.app
# Ledgerly's take rate in basis points (800 = 8%).
PLATFORM_FEE_BPS=800
# Bearer token Ledgerly's backend uses for /api/sellers, /api/checkouts, /api/orders, /api/reconcile.
ADMIN_API_TOKEN=          # openssl rand -hex 32
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/ops.
CRON_SECRET=              # openssl rand -hex 32
# Optional: Slack-compatible incoming webhook for ops alerts.
ALERT_WEBHOOK_URL=

# ── Sign-in ──────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=           # openssl rand -hex 32 (signs every session cookie)
# Staff "Sign in with Whop": the OAuth app's client id (app_…), with redirect URI
# $APP_URL/api/auth/whop/callback. Create it with `whop apps create --redirect_uris …`, then in
# the dashboard: the app's Permissions tab → add oauth:token_exchange, and copy the client
# secret from its OAuth tab (the CLI doesn't return it).
WHOP_OAUTH_CLIENT_ID=
WHOP_OAUTH_CLIENT_SECRET= # the app's OAuth tab (Confidential mode)
# Demo sign-in links for sellers (replace with Ledgerly's auth; see HANDOVER.md).
DEMO_LOGIN_ENABLED=false

# ── Marketplace (Supabase Auth + Storage) ────────────────────────────────────────────────
# Seller sign-in (/sell/login) and product files. Auth → URL Configuration must allow
# $APP_URL/auth/callback; providers: Email, Google, and custom OIDC "whop" (id custom:whop).
# Storage: private bucket "deliverables", 10 MB file size limit.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: signs file upload and download URLs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
