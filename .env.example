# ── Whop ────────────────────────────────────────────────────────────────────────────────
# Account API key for Ledgerly's platform account (server-side only). Scopes: README "API key scopes".
WHOP_API_KEY=apik_...
WHOP_PLATFORM_ACCOUNT_ID=biz_...
# Written by `pnpm ledgerly webhook:create` (the secret is shown only once).
WHOP_WEBHOOK_SECRET=ws_...
WHOP_WEBHOOK_ID=hook_...

# ── Database (Supabase transaction pooler, port 6543) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── App ─────────────────────────────────────────────────────────────────────────────────
# Public https URL (account links require https return/refresh URLs).
APP_URL=https://your-app.vercel.app
# Ledgerly's default take rate in basis points (800 = 8%). Operators can set a rate per seller.
PLATFORM_FEE_BPS=800
# Bearer token Ledgerly's backend uses for /api/sellers, /api/checkouts, /api/orders, /api/reconcile.
ADMIN_API_TOKEN=          # openssl rand -hex 32
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/ops.
CRON_SECRET=              # openssl rand -hex 32
# Optional: Slack-compatible incoming webhook for ops alerts.
ALERT_WEBHOOK_URL=
# Optional: the hourly job's page (e.g. https://vercel.com/<team>/<project>/settings/cron-jobs), linked from the console.
OPS_JOB_URL=

# ── Sign-in ──────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=           # openssl rand -hex 32 (signs the console and demo-link session cookies)
# Staff "Sign in with Whop" for the console at /: the Whop OAuth app "Ledgerly Console" (app_…),
# redirect URI $APP_URL/api/auth/whop/callback. On the app: Permissions tab → oauth:token_exchange;
# OAuth tab → Confidential, copy the client secret (`whop apps create` doesn't return it).
WHOP_OAUTH_CLIENT_ID=
WHOP_OAUTH_CLIENT_SECRET=
# Demo sign-in links (`pnpm ledgerly login-link`). Keep false in production.
DEMO_LOGIN_ENABLED=false

# ── Demo marketplace (/shop, /sell) ──────────────────────────────────────────────────────
# Sellers' "Continue with Whop": the seller-facing Whop OAuth app "Ledgerly" (app_…), redirect URI
# $APP_URL/auth/whop/callback, set up like the console app. The key is its client secret.
WHOP_SELLER_APP_ID=
WHOP_SELLER_APP_KEY=
# Supabase Auth (seller email + password, Google) and Storage (private bucket "deliverables",
# 10 MB limit). Auth → URL Configuration must allow $APP_URL/auth/callback.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only (signs file URLs, starts sessions for Whop sign-ins). Use the legacy service_role JWT
# (eyJ…): Storage's REST API rejects the new sb_secret_ keys.
SUPABASE_SERVICE_ROLE_KEY=
