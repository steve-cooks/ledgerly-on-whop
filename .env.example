# Whop Account API key for the Ledgerly platform account (server-side only)
WHOP_API_KEY=
WHOP_PLATFORM_ACCOUNT_ID=biz_xxxxxxxxxxxxxx
# Signing secret returned once when the webhook is created (ws_...)
WHOP_WEBHOOK_SECRET=
# Supabase transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
APP_URL=http://localhost:3000
PLATFORM_FEE_BPS=800
